{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@entropylab/core": ["../../packages/core/src/index.ts"],
      "@entropylab/fixtures": ["../../packages/fixtures/src/index.ts"],
      "@entropylab/report": ["../../packages/report/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
